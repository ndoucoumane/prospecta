# ==============================================================================
# PROSPECTA BACKEND - FICHIER .ENV POUR DEPLOIEMENT SERVEUR (180.149.196.68)
# A copier sur le serveur dans : /opt/prospecta/production/prospecta-prod.env
# ==============================================================================

# Profil Spring & Port (Port 8085 pour éviter le conflit avec Jenkins sur 8080)
SPRING_PROFILES_ACTIVE=prod
PORT=8085

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL (Production)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=prospecta_prod_db
DATABASE_USERNAME=prospecta_prod
DATABASE_PASSWORD=CHANGE_ME_PROD_DB_PASSWORD

# ------------------------------------------------------------------------------
# 2. Redis Cache & Distributed Lock (Production)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_SSL_ENABLED=false

# ------------------------------------------------------------------------------
# 3. Apache Kafka (Production)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# 4. Keycloak Identity Provider (Production https://auth.clatous.com)
# ------------------------------------------------------------------------------
KEYCLOAK_AUTH_SERVER_URL=https://auth.clatous.com
KEYCLOAK_REALM=clatous-production
KEYCLOAK_ISSUER_URI=https://auth.clatous.com/realms/clatous-production
KEYCLOAK_JWK_SET_URI=https://auth.clatous.com/realms/clatous-production/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=clatous-backend-prod
KEYCLOAK_CLIENT_SECRET=QWyJjXyZ7GPibKO21mw10lY3J2AzJlvqoU2IA6ODHxLlumIynJVPQxLzJolNYxRc2toMheLInzdcKYLeMStJKE

# Identifiants Admin Keycloak pour la création programmatique des utilisateurs (/api/v1/auth/register)
KEYCLOAK_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=soloSaliou10@
KEYCLOAK_ADMIN_REALM=master

# ------------------------------------------------------------------------------
# 5. Sécurité CORS (Domaines Frontend Autorisés)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.prospecta.sn,https://prospecta.sn,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Intelligence Artificielle (OpenAI)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# ------------------------------------------------------------------------------
# 7. Apollo B2B Data Provider (Découverte & Enrichissement)
# ------------------------------------------------------------------------------
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_API_KEY=CHANGE_ME_APOLLO_API_KEY
APOLLO_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 8. Meta WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=CHANGE_ME_WHATSAPP_APP_SECRET

# ------------------------------------------------------------------------------
# 9. Facturation, Abonnements & Stripe
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_live_CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_STARTER=price_starter_CHANGE_ME
STRIPE_PRICE_BUSINESS=price_business_CHANGE_ME

# ------------------------------------------------------------------------------
# 10. Email SMTP (Production)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=CHANGE_ME_SENDGRID_OR_SMTP_PASSWORD
MAIL_FROM=notifications@prospecta.sn

# ------------------------------------------------------------------------------
# 11. SMS (Africa's Talking / Orange)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=africastalking

# ------------------------------------------------------------------------------
# 12. Moteur de Campagnes & Prospection
# ------------------------------------------------------------------------------
CAMPAIGN_ENABLED=true
CAMPAIGN_MAX_CONCURRENT=15
