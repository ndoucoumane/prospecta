SPRING_PROFILES_ACTIVE=staging
PORT=8082

# Base de données PostgreSQL (Staging)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=prospecta_staging_db
DATABASE_USERNAME=prospecta_staging
DATABASE_PASSWORD=CHANGE_ME_STAGING_PASSWORD

# Redis (Staging)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Apache Kafka (Staging)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak Auth (Staging / Remote Keycloak https://auth.clatous.com)
KEYCLOAK_AUTH_SERVER_URL=https://auth.clatous.com
KEYCLOAK_REALM=clatous-production
KEYCLOAK_ISSUER_URI=https://auth.clatous.com/realms/clatous-production
KEYCLOAK_JWK_SET_URI=https://auth.clatous.com/realms/clatous-production/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=clatous-backend-prod
KEYCLOAK_CLIENT_SECRET=QWyJjXyZ7GPibKO21mw10lY3J2AzJlvqoU2IA6ODHxLlumIynJVPQxLzJolNYxRc2toMheLInzdcKYLeMStJKE

KEYCLOAK_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=soloSaliou10@
KEYCLOAK_ADMIN_REALM=master

# OpenAI Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# Apollo B2B Data Provider
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_API_KEY=
APOLLO_TIMEOUT_SECONDS=15

# Meta WhatsApp Business Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=prospecta_staging_token
WHATSAPP_APP_SECRET=

# Email Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=staging@prospecta.sn

# SMS Configuration
SMS_ENABLED=false
SMS_PROVIDER=africastalking

# Campaign Settings
CAMPAIGN_ENABLED=true
CAMPAIGN_MAX_CONCURRENT=5
CORS_ALLOWED_ORIGINS=http://180.149.196.68:3000,http://staging.prospecta.sn,http://localhost:5173
