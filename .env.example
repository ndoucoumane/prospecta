# ==============================================================================
# PROSPECTA BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT
# ==============================================================================

# Application Environment
SPRING_PROFILES_ACTIVE=local
PORT=8080

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=prospecta_db
DATABASE_USERNAME=prospecta
DATABASE_PASSWORD=prospecta_dev_password

# Redis Cache & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak Identity Provider
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/prospecta
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/prospecta/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=prospecta-backend
KEYCLOAK_CLIENT_SECRET=

# OpenAI Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# Apollo B2B Data Provider
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_API_KEY=
APOLLO_TIMEOUT_SECONDS=15

# Meta WhatsApp Business Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=prospecta_verify_token_dev
WHATSAPP_APP_SECRET=

# Email Configuration (Default to local Mailpit in dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=contact@prospecta.sn

# SMS Configuration
SMS_ENABLED=false
SMS_PROVIDER=africastalking

# Campaign Settings
CAMPAIGN_MAX_CONCURRENT=10
