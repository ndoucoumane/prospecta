# ============================================================

# PROSPECTA BACKEND - .gitignore

# Java / Spring Boot / Maven / Docker / IDE / Secrets

# ============================================================

# ------------------------------------------------------------

# Java - Compiled files

# ------------------------------------------------------------

*.class
*.log

# ------------------------------------------------------------

# Maven

# ------------------------------------------------------------

target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Maven Wrapper

.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------

# Java packages / archives

# ------------------------------------------------------------

*.jar
*.war
*.ear
*.nar
*.zip
*.tar
*.tar.gz
*.rar

# ------------------------------------------------------------

# JVM crash / profiling files

# ------------------------------------------------------------

hs_err_pid*
replay_pid*
*.hprof

# ------------------------------------------------------------

# Spring Boot

# ------------------------------------------------------------

spring.log
application-local.yml
application-local.yaml

# Local Spring configuration

application-dev.yml
application-dev.yaml

# IMPORTANT:

# Do NOT ignore application.yml/application.properties

# if they contain only non-sensitive configuration.

#

# If they contain secrets, use environment variables instead.

# ------------------------------------------------------------

# Environment variables / Secrets

# ------------------------------------------------------------

.env
.env.*
!.env.example

*.env

# Production environment files

.env.production
.env.prod
application-prod.yml
application-prod.yaml

# Secrets / credentials

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer

# Private SSH keys

id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# ------------------------------------------------------------

# IDE - IntelliJ IDEA

# ------------------------------------------------------------

.idea/
*.iml
*.iws
*.ipr

# ------------------------------------------------------------

# IDE - Eclipse

# ------------------------------------------------------------

.classpath
.project
.settings/
.factorypath
.springBeans

# ------------------------------------------------------------

# IDE - VS Code

# ------------------------------------------------------------

.vscode/

# ------------------------------------------------------------

# IDE - NetBeans

# ------------------------------------------------------------

/nbproject/private/
/nbbuild/
/dist/
/.nb-gradle/

